# The virtual environment hardcodes absolute paths to the machine that made
# it, so it must never be shared. Everyone creates their own -- run.bat does.
.venv/
venv/

__pycache__/
*.py[cod]

# Files people upload while using the site. Not part of the code.
media/

# Generated by collectstatic; the originals live in static/
staticfiles/

# Local overrides
.env
*.env
!*.env.example
db.sqlite3
*.log
