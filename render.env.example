# ===================================================================
#  SkillScope - settings for Render
#
#  Where these go:  Render dashboard -> your web service -> Environment
#
#  If you deployed with the Blueprint (render.yaml), DATABASE_URL and
#  SKILLSCOPE_SECRET_KEY are already filled in for you. You only need
#  to add CLOUDINARY_URL.
#
#  If you created the service by hand instead, add all the REQUIRED
#  values below. Render's "Add from .env" button accepts this file's
#  format -- replace each placeholder with your real value first.
#
#  Never commit a copy of this file with real values in it.
# ===================================================================


# -------------------------------------------------------------------
# REQUIRED - the site will refuse to start without these
# -------------------------------------------------------------------

# The PostgreSQL database. Render -> your database -> Connections ->
# copy "Internal Database URL" (not External - internal is faster and free).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE

# Signs login sessions. Any long random string, 50+ characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
# Keep it secret. Changing it later signs everybody out.
SKILLSCOPE_SECRET_KEY=replace-with-a-long-random-string

# Where uploaded files (videos, PDFs, photos) are stored. Render wipes its
# own disk on every deploy, so they cannot be kept there.
# Cloudinary dashboard -> "API environment variable" -> copy the whole line.
#
# Two Cloudinary settings to check first, or uploads will look fine and then
# fail for learners:
#   1. The API key needs permission to upload (Settings -> API Keys).
#   2. Settings -> Security -> tick "Allow delivery of PDF and ZIP files".
#      New accounts have this OFF: PDFs upload, but every download is refused.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME


# -------------------------------------------------------------------
# SET AUTOMATICALLY BY RENDER - normally leave these alone
# -------------------------------------------------------------------

# Render adds these on its own. They are listed so you know they exist:
#
#   RENDER=true
#   RENDER_EXTERNAL_HOSTNAME=skillscope.onrender.com
#   PORT=10000
#
# SkillScope reads RENDER_EXTERNAL_HOSTNAME to learn its own address, which
# goes into every certificate's QR code.


# -------------------------------------------------------------------
# OPTIONAL - only if you need them
# -------------------------------------------------------------------

# The public address printed into certificate QR codes. Normally worked out
# from RENDER_EXTERNAL_HOSTNAME. Set it yourself if you add a custom domain.
# SKILLSCOPE_SITE_URL=https://skillscope.onrender.com

# Extra domain names to accept, comma separated - e.g. a custom domain.
# SKILLSCOPE_HOSTS=learn.example.com,www.learn.example.com

# Number of worker processes. 2 suits Render's free and starter plans.
# WEB_CONCURRENCY=2

# NEVER set this to 1 on a public site. It shows full error details,
# including code and settings, to anyone who triggers an error.
# SKILLSCOPE_DEBUG=0
